---
interface Props {
  hours?: 24 | 168;
  ranges?: boolean;
}

const { hours = 24, ranges = false } = Astro.props;
---

<div class="online-chart" data-online-chart data-hours={hours}>
  {
    ranges && (
      <div class="online-chart__ranges" role="group" aria-label="Период">
        <button class="range-button" type="button" data-chart-range="24" aria-pressed={String(hours === 24)}>
          24 часа
        </button>
        <button class="range-button" type="button" data-chart-range="168" aria-pressed={String(hours === 168)}>
          7 дней
        </button>
      </div>
    )
  }
  <div class="online-chart__frame">
    <div class="online-chart__plot" data-chart-plot></div>
    <div class="online-chart__tooltip" data-chart-tooltip hidden></div>
  </div>
  <p class="online-chart__summary" data-chart-summary aria-live="polite">Загружаем историю онлайна…</p>
  <details class="online-chart__table">
    <summary>Показать таблицей</summary>
    <div class="table-scroll">
      <table class="data-table">
        <thead>
          <tr><th scope="col">Час</th><th scope="col">Больше всего игроков</th></tr>
        </thead>
        <tbody data-chart-table></tbody>
      </table>
    </div>
  </details>
</div>

<style is:global>
  .online-chart {
    display: grid;
    gap: 1rem;
  }

  .online-chart__ranges {
    display: flex;
    gap: 0.5rem;
  }

  .range-button {
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: transparent;
    color: var(--ink-soft);
    font: inherit;
    font-size: var(--text-small);
    cursor: pointer;
  }

  .range-button:hover {
    color: var(--ink);
    border-color: var(--ink-muted);
  }

  .range-button[aria-pressed="true"] {
    background: var(--lamp-wash);
    border-color: rgb(226 165 91 / 0.5);
    color: var(--ink);
  }

  .online-chart__frame {
    position: relative;
    padding: 1rem 1rem 0.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-panel);
    background: var(--ground-raised);
  }

  .online-chart__plot {
    position: relative;
    min-height: 240px;
    transition: opacity 0.2s ease;
  }

  .is-loading .online-chart__plot {
    opacity: 0.55;
  }

  .chart {
    display: block;
    width: 100%;
    height: 240px;
    overflow: visible;
    touch-action: pan-y;
  }

  .chart:focus-visible {
    outline-offset: 6px;
  }

  .chart__grid {
    stroke: var(--line);
    stroke-width: 1;
    shape-rendering: crispEdges;
  }

  .chart__axis {
    fill: var(--ink-muted);
    font-size: 11px;
    font-variant-numeric: tabular-nums;
  }

  .chart__line {
    fill: none;
    stroke: var(--chart-line);
    stroke-width: 2;
    stroke-linejoin: round;
    stroke-linecap: round;
  }

  .chart__area {
    fill: var(--chart-area);
  }

  .chart__single {
    fill: var(--chart-line);
  }

  .chart__offline {
    fill: var(--offline);
    opacity: 0.6;
  }

  .chart__crosshair {
    stroke: var(--ink-muted);
    stroke-width: 1;
  }

  .chart__marker {
    fill: var(--chart-line);
    stroke: var(--ground-raised);
    stroke-width: 2;
  }

  .chart-empty {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 2rem;
    text-align: center;
    color: var(--ink-muted);
  }

  .online-chart__tooltip {
    position: absolute;
    top: 0.75rem;
    transform: translateX(-50%);
    display: grid;
    padding: 0.4rem 0.7rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-control);
    background: var(--panel);
    font-size: var(--text-small);
    white-space: nowrap;
    pointer-events: none;
    box-shadow: 0 8px 20px rgb(0 0 0 / 0.35);
  }

  .online-chart__tooltip span {
    color: var(--ink-muted);
  }

  .online-chart__summary {
    color: var(--ink-soft);
  }

  .online-chart__table summary {
    width: fit-content;
    color: var(--ink-muted);
    font-size: var(--text-small);
    cursor: pointer;
  }

  .online-chart__table .table-scroll {
    margin-top: 0.75rem;
    max-height: 20rem;
    overflow-y: auto;
  }
</style>
