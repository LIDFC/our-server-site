# Copy to .env and adjust. Relative paths are resolved from the project folder.
# Secrets here: GITHUB_TOKEN and REGISTER_INVITE_CODE; .env is ignored by git.

# --- web server -----------------------------------------------------------------
# keep 127.0.0.1: nginx in front of the site talks to it locally
HOST=127.0.0.1
PORT=3000
# true when nginx (or another reverse proxy) passes the visitor address in X-Real-IP
TRUST_PROXY=true
SERVER_NAME=Our Server

# built site (npm run build) and runtime data such as the online history
PUBLIC_DIR=dist
DATA_DIR=data
GALLERY_DIR=content/gallery

# --- Minecraft server --------------------------------------------------------------
# where the site asks for the status; the Minecraft server runs on the same machine
MC_HOST=127.0.0.1
MC_PORT=25565
# address players type in Minecraft, shown on the site
MC_PUBLIC_ADDRESS=mc.vin-off.site
# folder with server.properties and usercache.json; statistics are read from <MC_SERVER_DIR>/<MC_WORLD>/stats
MC_SERVER_DIR=/home/ubuntu/minecraft
MC_WORLD=world

STATUS_CACHE_SECONDS=15
STATUS_TIMEOUT_MS=5000
STATS_CACHE_SECONDS=300

# --- online history ----------------------------------------------------------------
HISTORY_INTERVAL_SECONDS=300
HISTORY_RETENTION_DAYS=7

# --- squaremap -----------------------------------------------------------------------
# leave empty until squaremap is set up, the site then shows the map as not available yet
MAP_URL=
# squaremap name of the overworld, visible in the link the map copies
MAP_WORLD=minecraft_overworld

# --- launcher ------------------------------------------------------------------------
LAUNCHER_REPO=LIDFC/MkeiitLauncher
# optional: raises the GitHub API limit, a token without any scopes is enough
GITHUB_TOKEN=
LAUNCHER_CACHE_SECONDS=600

# --- API protection ------------------------------------------------------------------
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120

# --- accounts -------------------------------------------------------------------------
# shared registration code: empty means registration is closed.
# This is a secret, give it only to the players. Changing it does not touch existing accounts.
REGISTER_INVITE_CODE=
# true in production (the session cookie then needs https), false for local development
COOKIE_SECURE=true
# how long a session stays valid, every visit pushes it forward
SESSION_TTL_DAYS=30
# brute force protection for registration, sign in and password changes: per address and per login
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_RATE_LIMIT_MAX_REQUESTS=10

# --- skins ----------------------------------------------------------------------------
# where uploaded skins are stored; the folder must be writable by the service user
SKIN_UPLOAD_DIR=uploads/skins
# hard server side limit, the browser check is only for convenience
SKIN_MAX_UPLOAD_BYTES=8388608
# pause between two uploads of the same account
SKIN_UPLOAD_COOLDOWN_SECONDS=20
SKIN_UPLOAD_LIMIT_WINDOW_SECONDS=600
SKIN_UPLOAD_LIMIT_MAX_REQUESTS=10

# --- Minecraft integration ---------------------------------------------------------------
# shared secret between the site and the our-server-plugin on the Minecraft server: it lets the
# server report that a player ran /skin clear. Empty means the integration is switched off.
# Generate one with: openssl rand -hex 32
MINECRAFT_API_TOKEN=

# --- site address ----------------------------------------------------------------------
# used by the build and by the server: the public skin URL is built from it
PUBLIC_SITE_URL=https://mc.vin-off.site
PUBLIC_MC_ADDRESS=mc.vin-off.site
PUBLIC_SERVER_NAME=Our Server
PUBLIC_LAUNCHER_REPO=LIDFC/MkeiitLauncher
